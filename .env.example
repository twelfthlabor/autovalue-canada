# The current evidence-first demo has no secrets.
# Future licensed provider keys must remain server-side and must not use NEXT_PUBLIC_ prefixes.
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# --- Postgres warehouse (local Docker == RDS-compatible, PostgreSQL 16) ---
# Local:  postgresql+psycopg://autovalue:autovalue@localhost:5432/autovalue
# RDS:    postgresql+psycopg://<user>:<password>@<endpoint>:5432/autovalue
POSTGRES_USER=autovalue
POSTGRES_PASSWORD=autovalue
POSTGRES_DB=autovalue
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://autovalue:autovalue@localhost:5432/autovalue

# --- AWS raw zone (optional; ETL falls back to data/raw/*.csv) ---
# Same boto3 code path runs locally and against S3. Free-tier friendly:
# upload the two CSVs once, then run with S3_PRICE_STATS_URI set.
AWS_REGION=ca-central-1
S3_PRICE_STATS_URI=
S3_INVENTORY_URI=
