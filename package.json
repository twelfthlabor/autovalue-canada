{
  "name": "autovalue-canada",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "description": "A transparent Canadian used-vehicle deal checker with VIN decode and mileage-adjusted comparables.",
  "scripts": {
    "dev": "next dev",
    "build:data": "node scripts/build-market-data.mjs",
    "model:benchmark": "python analysis/train_benchmark.py",
    "model:train-condition": "python analysis/train_condition_model.py",
    "prebuild": "npm run build:data",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "animejs": "4.5.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20.9"
  }
}
